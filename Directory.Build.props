<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <!-- Keep restore graphs consistent between normal builds and portable publishing. -->
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">win-x64</RuntimeIdentifiers>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).tools/packages</RestorePackagesPath>
  </PropertyGroup>
</Project>
