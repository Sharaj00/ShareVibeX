<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.18.0</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <ProjectReference Include="../ShareVibeX.Core/ShareVibeX.Core.csproj" />
    <ProjectReference Include="../ShareVibeX.Platform.Windows/ShareVibeX.Platform.Windows.csproj" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <Target Name="CreatePortableLauncher" AfterTargets="Publish" Condition="'$(PortableLauncherPath)' != ''">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(PortableLauncherPath)"
                   AppBinaryName="libs/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="true"
                   DotNetSearchLocations="AppLocal" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
  </Target>
</Project>






